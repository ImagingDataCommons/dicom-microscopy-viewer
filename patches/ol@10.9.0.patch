+/**
+ * The box of the drawing buffer that an extent covers in a frame: the bounds
+ * of its four corners (the view may be rotated) in device pixels, one pixel
+ * wider on each side, clipped to the buffer.
+ * @param {import("../../Map.js").FrameState} frameState Frame state.
+ * @param {import("../../extent.js").Extent|undefined} extent Extent in view
+ * coordinates.
+ * @return {Array<number>|null} Box [x, y, width, height] with the origin at
+ * the bottom left, or null when there is no extent or it covers the buffer.
+ */
+export function getExtentScissor(frameState, extent) {
+  if (!extent || !extent.every(Number.isFinite)) {
+    return null;
+  }
+  const transform = frameState.coordinateToPixelTransform;
+  const pixelRatio = frameState.pixelRatio;
+  const width = Math.round(frameState.size[0] * pixelRatio);
+  const height = Math.round(frameState.size[1] * pixelRatio);
+  const corners = [
+    [extent[0], extent[1]],
+    [extent[0], extent[3]],
+    [extent[2], extent[1]],
+    [extent[2], extent[3]],
+  ];
+  let minX = Infinity;
+  let minY = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  for (const corner of corners) {
+    const pixel = applyTransform(transform, corner);
+    minX = Math.min(minX, pixel[0]);
+    maxX = Math.max(maxX, pixel[0]);
+    minY = Math.min(minY, pixel[1]);
+    maxY = Math.max(maxY, pixel[1]);
+  }
+  const left = Math.max(0, Math.floor(minX * pixelRatio) - 1);
+  const right = Math.min(width, Math.ceil(maxX * pixelRatio) + 1);
+  const top = Math.max(0, Math.floor(minY * pixelRatio) - 1);
+  const bottom = Math.min(height, Math.ceil(maxY * pixelRatio) + 1);
+  if (left <= 0 && top <= 0 && right >= width && bottom >= height) {
+    return null;
+  }
+  return [
+    left,
+    Math.max(0, height - Math.max(bottom, top)),
+    Math.max(0, right - left),
+    Math.max(0, bottom - top),
+  ];
+}
